{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=aip_portal_dev;Username=aip_portal;Password=aip_portal_dev_password"
  },
  "DataProtection": {
    "KeysPath": "./data/protection-keys"
  },
  "FileStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "./data/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ],
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "image/png",
      "image/jpeg",
      "application/zip",
      "text/plain",
      "text/markdown"
    ],
    "UseSignedUrls": false,
    "BucketName": "",
    "Region": "",
    "Endpoint": "",
    "UsePathStyle": false
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "HeaderForDevelopmentOnly",
    "AllowTenantSwitching": true,
    "SeedOnStartup": false,
    "AllowDevelopmentHeaderInProduction": false,
    "AllowDevelopmentHeaderTenantResolution": true,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "aip_tenant"
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest",
    "RequireHttps": false,
    "EnableHsts": false,
    "EnableCsrfProtection": true,
    "EnableRateLimiting": false,
    "LoginLockoutEnabled": false,
    "MaxFailedLoginAttempts": 10,
    "LoginLockoutDurationMinutes": 15
  },
  "Platform": {
    "EnablePlatformAdmin": true,
    "PlatformAdminSetupMode": true,
    "AllowTenantCreationFromAdmin": true,
    "EnablePlansAndSubscriptions": true,
    "EnableUsageQuota": true
  },
  "Features": {
    "EnableRadialMenu": true,
    "EnableDockingLayout": true,
    "EnableForms": true,
    "EnableEvents": true,
    "EnableProductionTracking": true,
    "EnableWebhooks": true,
    "EnableApiTokens": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
