{
  "name": "aipsite-nyg-ui-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "serve:ui": "node tests/ui/serve-static.mjs",
    "test": "node tests/ui/run-angular-playwright.mjs",
    "test:ui": "node tests/ui/run-angular-playwright.mjs",
    "test:ui:angular": "node tests/ui/run-angular-playwright.mjs",
    "test:ui:angular:docker": "node tests/ui/run-angular-playwright-compose.mjs",
    "test:ui:angular:docker:update-snapshots": "docker compose -f docker-compose.playwright.yml run --build --rm angular-playwright bash -lc \"npm ci && npm --prefix frontend ci && npm --prefix frontend run build && npm run test:ui:angular -- --update-snapshots\"",
    "test:ui:real-backend": "node tests/ui/run-real-backend-smoke-compose.mjs",
    "test:ui:real-backend:compose": "node tests/ui/run-real-backend-smoke-compose.mjs",
    "test:ui:real-backend:runner": "node --test tests/ui/real-backend-smoke-compose-helpers.node-test.mjs",
    "test:ui:public-https": "node tests/ui/run-public-https-golden-path.mjs",
    "test:ui:public-https:runner": "node --test tests/ui/public-https-golden-path-helpers.node-test.mjs",
    "lint:frontend": "npm --prefix tools/frontend-inspections run lint",
    "lint:frontend:verbose": "npm --prefix tools/frontend-inspections run lint:verbose",
    "lint:frontend:enforce": "npm --prefix tools/frontend-inspections run lint:enforce"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "rg": "^0.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  },
  "license": "UNLICENSED"
}
