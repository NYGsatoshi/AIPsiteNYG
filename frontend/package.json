{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "syncfusion:activate": "node scripts/require-syncfusion-license.mjs && syncfusion-license activate",
    "build:licensed": "npm run syncfusion:activate && npm run build",
    "build:hosted": "npm run build && node scripts/copy-hosted-output.mjs",
    "build:hosted:licensed": "npm run syncfusion:activate && npm run build:hosted",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.node-test.mjs",
    "test:syncfusion-license": "node --test scripts/require-syncfusion-license.node-test.mjs",
    "analyze:bundle": "node scripts/check-syncfusion-bundle.mjs",
    "storybook": "ng run frontend:storybook",
    "build-storybook": "ng run frontend:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@lucide/angular": "1.27.0",
    "@microsoft/signalr": "10.0.0",
    "@ngrx/component-store": "21.1.1",
    "@ngrx/effects": "21.1.1",
    "@ngrx/entity": "21.1.1",
    "@ngrx/store": "21.1.1",
    "@syncfusion/ej2-angular-gantt": "34.1.30",
    "@syncfusion/ej2-angular-grids": "34.1.33",
    "@syncfusion/ej2-angular-inputs": "34.1.32",
    "@syncfusion/ej2-angular-popups": "34.1.29",
    "ag-grid-angular": "36.0.2",
    "ag-grid-community": "36.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.19",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@storybook/angular": "10.5.5",
    "@types/node": "24.13.2",
    "axe-core": "4.12.1",
    "jsdom": "28.0.0",
    "prettier": "3.9.6",
    "storybook": "10.5.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@syncfusion/ej2-angular-base@34.1.29": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "undici": "7.28.0",
    "@babel/core": "7.29.7",
    "http-proxy-middleware": "3.0.7",
    "esbuild": "0.28.1",
    "ajv": "8.18.0",
    "picomatch": "4.0.4",
    "http-auth": "4.2.1",
    "uuid": "11.1.1",
    "body-parser": "1.20.6"
  }
}
