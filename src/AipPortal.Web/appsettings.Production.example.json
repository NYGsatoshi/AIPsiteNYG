{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=5432;Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "FileStorage": {
    "Provider": "ObjectStorage",
    "RootPath": "/app/data/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ],
    "UseSignedUrls": false,
    "BucketName": "${FILE_STORAGE_BUCKET}",
    "Region": "${FILE_STORAGE_REGION}",
    "Endpoint": "${FILE_STORAGE_ENDPOINT}",
    "UsePathStyle": false
  },
  "Security": {
    "Cookies": {
      "RequireSecure": true
    }
  },
  "UiShell": {
    "SeedOnStartup": false
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "Host",
    "AllowTenantSwitching": true,
    "SeedOnStartup": false,
    "AllowDevelopmentHeaderInProduction": false,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "aip_tenant"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "your-domain.example"
}
