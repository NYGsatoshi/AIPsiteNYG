{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aip_portal;Username=aip_portal"
  },
  "FileStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "./data/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ],
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "image/png",
      "image/jpeg",
      "application/zip",
      "text/plain",
      "text/markdown"
    ],
    "UseSignedUrls": false,
    "BucketName": "",
    "Region": "",
    "Endpoint": "",
    "UsePathStyle": false
  },
  "UiShell": {
    "SeedOnStartup": false
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "Host",
    "AllowTenantSwitching": true,
    "SeedOnStartup": false,
    "AllowDevelopmentHeaderInProduction": false,
    "AllowDevelopmentHeaderTenantResolution": false,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "aip_tenant"
  },
  "Security": {
    "CookieSecurePolicy": "Always",
    "RequireHttps": true,
    "EnableHsts": true,
    "EnableCsrfProtection": true,
    "EnableRateLimiting": true,
    "LoginLockoutEnabled": true,
    "MaxFailedLoginAttempts": 5,
    "LoginLockoutDurationMinutes": 15,
    "PasswordHashing": {
      "Algorithm": "PBKDF2"
    }
  },
  "Platform": {
    "EnablePlatformAdmin": true,
    "PlatformAdminSetupMode": false,
    "AllowTenantCreationFromAdmin": true,
    "EnablePlansAndSubscriptions": true,
    "EnableUsageQuota": true
  },
  "Features": {
    "EnableRadialMenu": true,
    "EnableDockingLayout": true,
    "EnableForms": true,
    "EnableEvents": true,
    "EnableProductionTracking": true,
    "EnableWebhooks": false,
    "EnableApiTokens": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
