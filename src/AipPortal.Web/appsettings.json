{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aip_portal;Username=aip_portal;Password=change-me"
  },
  "FileStorage": {
    "RootPath": "storage/uploads",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ]
  },
  "UiShell": {
    "SeedOnStartup": false
  },
  "Security": {
    "PasswordHashing": {
      "Algorithm": "PBKDF2"
    },
    "Cookies": {
      "RequireSecure": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
