{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aip_portal;Username=aip_portal"
  },
  "FileStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "./data/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ],
    "UseSignedUrls": false,
    "BucketName": "",
    "Region": "",
    "Endpoint": "",
    "UsePathStyle": false
  },
  "UiShell": {
    "SeedOnStartup": false
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "Host",
    "AllowTenantSwitching": true,
    "SeedOnStartup": false,
    "AllowDevelopmentHeaderInProduction": false,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "aip_tenant"
  },
  "Security": {
    "PasswordHashing": {
      "Algorithm": "PBKDF2"
    },
    "Cookies": {
      "RequireSecure": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
