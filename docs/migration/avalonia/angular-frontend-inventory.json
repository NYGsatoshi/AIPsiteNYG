  "integrations": [
    {
      "id": "rest",
      "kind": "REST",
      "currentClient": "Angular HttpClient",
      "base": "/api/*",
      "authentication": ["same-origin cookies", "CSRF token for unsafe requests"],
      "migrationConcern": "Preserve server DTO and authorization semantics while replacing browser-specific interceptor/session plumbing."
    },
    {
      "id": "rest-auth",
      "kind": "REST-authentication",
      "currentClient": "Angular HttpClient plus auth/session interceptors",
      "base": "/api/auth/*",
      "migrationConcern": "Desktop session bootstrap, expiration, logout and CSRF behavior must remain compatible with the backend contract."
    },
    {
      "id": "signalr",
      "kind": "SignalR",
      "currentClient": "@microsoft/signalr@10.0.11",
      "endpoint": "/hubs/app",
      "events": ["DurableEvent", "AuthorizationInvalidated"],
      "statuses": ["connecting", "reconnecting", "reconnected", "closed"],
      "subscriptions": ["user", "tenant", "workspace", "conversation", "project"],
      "automaticReconnectDelayMs": [0, 1000, 3000, 7000],
      "migrationConcern": "Use the .NET SignalR client but preserve CSRF/auth negotiation, subscription authorization, protected-state invalidation and stale-connection isolation."
    },
    {
      "id": "file-io",
      "kind": "file-and-binary-io",
      "operations": [
        "multipart POST /api/files with progress",
        "GET /api/files inventory and task picker pagination",
        "/api/search file search",
        "server-issued file and attachment download grants",
        "preview and download",
        "folder and move operations",
        "sharing and deletion",
        "version and activity history",
        "selection snapshot",
        "task attachment integration",
        "cancellation and stale-response protection",
        "realtime inventory refresh"
      ],
      "migrationConcern": "Replace browser File/FormData/Blob/object-URL/download primitives with native desktop I/O without weakening grant or cancellation semantics."
    }
  ],
